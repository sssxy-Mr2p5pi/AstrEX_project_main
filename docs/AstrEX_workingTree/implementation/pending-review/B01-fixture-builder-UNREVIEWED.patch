+def write(relative, content):
+    path = ROOT / relative
+    if not path.resolve().is_relative_to(ROOT):
+        raise ValueError("output escapes this worktree")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(content, encoding="utf-8")
